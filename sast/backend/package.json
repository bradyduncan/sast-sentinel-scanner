{
  "name": "sast-scanner",
  "version": "1.0.0",
  "description": "Static Application Security Testing (SAST) Scanner for Node.js applications",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "scan": "node cli.js",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads"
  },
  "keywords": [
    "sast",
    "security",
    "scanner",
    "vulnerability",
    "static-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/util-dynamodb": "^3.600.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "tar": "^7.4.0"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0",
    "vitest": "^2.1.0"
  }
}
